{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/depth-lab-v97", "destination": "/depth-lab-v97.html" },
    { "source": "/((?!assets/|src/|docs?(?:/|$)|tests?(?:/|$)|scripts(?:/|$)|references?(?:/|$)|exports?(?:/|$)|captures?(?:/|$)|screenshots?(?:/|$)|\\.git(?:/|$)|\\.env[^/]*(?:/|$)|\\.qa[^/]*(?:/|$)|\\.vercel(?:/|$)|depth-lab-v97(?:\\.html)?(?:/|$)|.*\\.css$|manifest\\.webmanifest$|sw\\.js$|build-info\\.json$|LICENSE_NOTICE\\.md$).*)", "destination": "/index.html" }
  ]
}
