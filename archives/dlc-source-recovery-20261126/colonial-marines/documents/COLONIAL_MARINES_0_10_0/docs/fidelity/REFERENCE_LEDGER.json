  "changes": [],
  "gaps": [
    {
      "domain": "Plans",
      "status": "partiel",
      "detail": "Tous les secteurs du jeu commercial ne sont pas encore relevés. Les salles de référence ajoutées ont des proportions originales. Aucun pourcentage de fidélité métrique annoncé."
    },
    {
      "domain": "Topologie globale",
      "status": "partiel",
      "detail": "Liaisons locales réciproques et approches contrôlées ; superposition géographique entre missions et dimensions réelles non certifiées."
    },
    {
      "domain": "Narration Stasis",
      "status": "partiel",
      "detail": "Noms Asylum/Awakening/Deliverance/Redemption et escorte de Hicks corrigés. Mort de Lisbeth/Stone, vol du skiff et capture : dossiers ou raccords, pas cinématiques 1:1."
    },
    {
      "domain": "Personnages",
      "status": "partiel",
      "detail": "Costumes différenciés. Visages, mensurations, animations, voix et l’ensemble des personnages secondaires non restitués 1:1."
    },
    {
      "domain": "Arsenal",
      "status": "partiel",
      "detail": "Les 21 profils sont utilisables, avec leur comportement de famille. La progression par XP/commendations, les pistolets à munitions infinies et l’abandon automatique des armes lourdes du jeu commercial ne sont pas encore reproduits ; la dotation tactique héritée est conservée."
    },
    {
      "domain": "Multijoueur et cartes DLC",
      "status": "absent",
      "detail": "Pas de coopération réseau, Versus, cartes Reconnaissance/Movie Map fidèles ni terrain Academy. Bug Hunt conserve trois arènes originales et ne prétend pas être Broadside/Mercenary/Tribute."
    },
    {
      "domain": "Archives originales",
      "status": "partiel",
      "detail": "Documents et dialogues originaux conservés ; pas transcription intégrale des audio logs, plaques et cinématiques du jeu."
    },
    {
      "domain": "Moteur Tantalus parent",
      "status": "non intégré",
      "detail": "Ce paquet reste autonome. Aucun push ou déploiement."
    }
  ],
