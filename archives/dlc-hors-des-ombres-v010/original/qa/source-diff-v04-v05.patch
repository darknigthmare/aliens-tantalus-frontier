+"""Package the cumulative DLC after QA, then verify every archived byte.
+Run from any directory with Python 3. Creates ZIP, SHA256SUMS and external audit.
+The audit is outside the ZIP to avoid a self-referential hash.
+"""
+from pathlib import Path
+import hashlib
+import json
+import zipfile
+
+ROOT = Path(__file__).resolve().parents[1]
+NAME = 'ALIEN_HORS_DES_OMBRES_V0_5_CE_QUI_ECOUTE_DANS_LE_NOIR.zip'
+ARCHIVE = ROOT.parent / NAME
+AUDIT = ROOT.parent / 'ALIEN_HORS_DES_OMBRES_V0_5_AUDIT_ARCHIVE.json'
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def main():
+    manifest = json.loads((ROOT / 'LIVRAISON.json').read_text())
+    qa = json.loads((ROOT / 'qa/RESULTATS_QA_V05.json').read_text())
+    documents = json.loads((ROOT / 'qa/document-audit-v05.json').read_text())
+    assert manifest['version'] == qa['version'] == '0.5.0'
+    assert qa['failed'] == documents['failed'] == 0
+    for rel, sha in qa['sourceSHA256'].items():
+        assert digest((ROOT / rel).read_bytes()) == sha, rel
+    for rel, sha in qa['resultFilesSHA256'].items():
+        assert digest((ROOT / 'qa' / rel).read_bytes()) == sha, rel
+    assert digest((ROOT / 'JOUER_HORS_DES_OMBRES.html').read_bytes()) == manifest['standaloneSHA256']
+    files = sorted(p for p in ROOT.rglob('*') if p.is_file()
+                   and '__pycache__' not in p.parts and p.name != 'SHA256SUMS.txt')
+    hashes = {p.relative_to(ROOT).as_posix(): digest(p.read_bytes()) for p in files}
+    sums = ROOT / 'SHA256SUMS.txt'
+    sums.write_text(''.join(f'{sha}  {rel}\n' for rel, sha in hashes.items()), encoding='utf-8')
+    files.append(sums)
+    with zipfile.ZipFile(ARCHIVE, 'w', zipfile.ZIP_DEFLATED, compresslevel=7) as z:
+        for p in files:
+            z.write(p, ROOT.name + '/' + p.relative_to(ROOT).as_posix())
+    with zipfile.ZipFile(ARCHIVE) as z:
+        assert z.testzip() is None
+        names = z.namelist()
+        assert len(names) == len(set(names)) == len(files)
+        for rel, sha in hashes.items():
+            assert digest(z.read(ROOT.name + '/' + rel)) == sha, rel
+        assert z.read(ROOT.name + '/SHA256SUMS.txt') == sums.read_bytes()
+        assert all('..' not in Path(n).parts and n.startswith(ROOT.name + '/') for n in names)
+    result = {
+        'version': manifest['version'], 'archive': ARCHIVE.name,
+        'bytes': ARCHIVE.stat().st_size, 'sha256': digest(ARCHIVE.read_bytes()),
+        'files': len(files), 'indexedSHA256Files': len(hashes),
+        'zipCRCVerified': True, 'allIndexedHashesVerified': True,
+        'sourceHashesMatchQA': True, 'duplicatesOrTraversalPaths': False,
+        'gameplayChecks': qa['totalTests'], 'documentChecks': documents['passed'],
+        'screenshots': manifest['counts']['screenshots'],
+        'nativeBrowserPersistenceCertified': False, 'nativeHostMerged': False,
+        'githubPush': False, 'vercelDeploy': False,
+        'auditOutsideArchive': True
+    }
+    AUDIT.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding='utf-8')
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+if __name__ == '__main__':
+    main()
