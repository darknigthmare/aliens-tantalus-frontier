  if goals:
   body+=table(['Étape / personnage','Objectif','Commande','Point / durée'],[[H(f'{c["index"]+1:02} · '+cast[c['actor']]['name']),H(o['label']),H(d['workOrders'].get(o['id'],{}).get('type','maintien / sélection')),'<code>'+H(o['node'])+'</code> · '+H(o['hold'])+' s'] for c,o in goals])
  else:body+='<p class="muted">Pas d’objectif principal imposé. Cette pièce sert au détour, à l’observation ou à la circulation locale.</p>'
