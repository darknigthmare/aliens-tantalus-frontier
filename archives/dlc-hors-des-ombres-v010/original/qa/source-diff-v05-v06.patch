 rule_text.extend([('17 — Un seul seuil acoustique', 'Le bruit de course, flamme, machine ou leurre peut attirer un adulte déjà instancié dans une pièce immédiatement voisine. Ni génération ennemie ni propagation récursive. Portée de trajet 980 unités × volume, mémoire 12 secondes.'), ('18 — Écouter n’est pas arrêter', 'V immobilise le joueur, pas le monde. Une direction et un type de bruit sont montrés, sans coordonnées ni inventaire d’ennemis. Un adulte immobile n’est pas un contact radar.'), ('19 — Le bruit masque', 'À moins de 540 unités horizontales d’une machine active, le relevé d’écoute est masqué. La machine n’efface pas la vision directe d’un adulte.'), ('20 — Leurre situé', 'Le lancer s’arrête devant les solides ; une pression R ne dépense qu’une charge. Le signal dure cinq secondes même si le joueur quitte la salle.'), ('21 — Répétition mémorisée', 'Un adulte ayant terminé deux inspections de 0,75 seconde dans une même bande de 180 unités peut ignorer un nouveau signal placé dans cette bande pendant 80 secondes de simulation. Ce n’est pas une adaptation au chalumeau.'), ('22 — Traces bornées', 'Boîtiers vides, brûlures et griffures sont cosmétiques et persistent dans le carnet, douze traces au maximum par salle. Elles ne changent pas les collisions et ne sont pas de nouveaux modèles du catalogue.'), ('23 — Avertissement compagnon', 'Un accompagnant qui voit un adulte proche signale le danger et prend une posture basse. L’ordre attendre ne devient ni un téléportage ni un ordre de combat.'), ('24 — Lisibilité des avant-plans', 'Un meuble ou coffret au premier plan recouvrant le personnage devient partiellement transparent. Une cachette occupée reste opaque. Cette règle de rendu ne change ni la vision ennemie ni l’empreinte solide.')])
-body='<header class="hero"><div class="wrap"><p class="eyebrow">TANTALUS FRONTIER / HORS DES OMBRES / V0.5.0</p><h1>Codex<br>du Marion</h1><p class="lead">Pièce par pièce : déplacements, seuils, objets, lumières et accompagnants. Registre extrait du code livré.</p>'+metrics([('lieux',34),('liaisons',40),('placements explicites',268),('fiches en jeu',len(d['codex']))])+'</div></header><main class="wrap"><section><h2>Lire le registre</h2><p>Coordonnées locales, et non métrique officielle : X suit la longueur, Y suit la profondeur du sol. La profondeur des schémas est amplifiée pour montrer les voies. Dans les couloirs en profil, les mobiles restent sur y=88.</p><p><span class="tag">CYAN · SEUIL</span><span class="tag">OR · POINT D’OBJECTIF</span><span class="tag">VIOLET · CACHETTE</span><span class="tag">ROSE · ACTIVITÉ</span><span class="tag">BRUN · SOLIDE</span></p><div class="note">Document de production avec spoilers. Les registres de portes, lumières et placements sont réellement utilisés ; les descriptions d’ambiance sont des intentions héritées, pas une certification que chaque détail graphique est définitif.</div><nav class="index">'+''.join(f'<a href="#{r["id"]}">{H(r["deck"])} · {H(r["name"])}</a>' for r in d['rooms'])+'</nav></section><section><h2>Règles de cette passe</h2><div class="grid">'+''.join('<article class="card"><h3>'+H(a)+'</h3><p>'+H(b)+'</p></article>' for a,b in rule_text)+'</div></section>'
+
+rule_text.extend([
+('25 — Chantiers facultatifs','Trois réparations ouvrent trois liaisons, pas trois nouvelles salles. Les chemins principaux et les portes de chapitre restent indépendants du stock de pièces.'),
+('26 — Paiement au geste terminé','Le capot ne coûte rien. Les trois composants sont débités à la fin du deuxième geste, une seule fois. Le dernier essai ouvre le passage. Relâcher E avant chaque nouveau geste et avant le premier franchissement.'),
+('27 — Travail exposé','Le maintien de réparation laisse le monde actif, émet du bruit et s’interrompt au déplacement, portage ou dommage. Une interruption conserve les gestes déjà terminés, pas les secondes du geste incomplet.'),
+('28 — Stock non renouvelable','Huit casiers fournissent chacun trois pièces. Leur état ouvert/vide est conservé. Les recettes et réparations partagent ces 24 composants ; aucun objectif principal ne les exige.'),
+('29 — Établi physique','Le sac I permet de consulter et de suivre un chantier observé. Fabriquer exige de rejoindre un des deux établis et de l’ouvrir par E ; la fenêtre suspend le monde. Capacité insuffisante : aucune dépense.'),
+('30 — Proximité et visibilité','Le relevé SVG de la salle représente les empreintes et points observés. X est proportionnel, la profondeur est agrandie. Ni adversaires cachés ni voyage rapide ; les salles inconnues ne sont pas nommées.')])
+body='<header class="hero"><div class="wrap"><p class="eyebrow">TANTALUS FRONTIER / HORS DES OMBRES / V0.6.0</p><h1>Codex<br>du Marion</h1><p class="lead">Les chemins de traverse. Trente-quatre pièces, les accès réparables et les registres réellement livrés.</p>'+metrics([('lieux',counts['rooms']),('liaisons',counts['edges']),('placements explicites',counts['propInstances']),('fiches en jeu',counts['codex'])])+'</div></header><main class="wrap"><section><h2>Lire le registre</h2><p>Coordonnées locales de jeu : X suit la longueur et Y la profondeur du sol. La profondeur des schémas est amplifiée. Les passages en profil limitent les mobiles à y=88. Les schémas ne sont pas des plans officiels.</p><div class="note">Document de production avec spoilers. Une intention graphique héritée n’est pas une promesse d’asset final : le rendu est vectoriel procédural provisoire. Le plan en jeu révèle moins de choses que ce codex.</div><p><span class="tag">CYAN · SEUIL</span><span class="tag">OR · OBJECTIF</span><span class="tag">VIOLET · CACHETTE</span><span class="tag">ROSE · ACTIVITÉ</span><span class="tag">BRUN · SOLIDE</span></p><nav class="index">'+''.join(f'<a href="#{r["id"]}">{H(r["deck"])} · {H(r["name"])}</a>' for r in d['rooms'])+'</nav></section><section id="regles"><h2>30 règles de construction et de simulation</h2><div class="grid">'+''.join('<article class="card"><h3>'+H(a)+'</h3><p>'+H(b)+'</p></article>' for a,b in rule_text)+'</div></section>'
