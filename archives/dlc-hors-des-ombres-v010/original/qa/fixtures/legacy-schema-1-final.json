  "journal": [
    {
      "chapter": 0,
      "text": "Le Marion ne reçoit plus les équipes au sol."
    },
    {
      "chapter": 0,
      "text": "La portée est courte. Quelqu’un doit encore pouvoir nous entendre."
    },
    {
      "chapter": 0,
      "text": "L’alimentation tient. Pour l’instant."
    },
    {
      "chapter": 1,
      "text": "La conduite du quai est isolée."
    },
    {
      "chapter": 1,
      "text": "La brèche est derrière la cloison."
    },
    {
      "chapter": 1,
      "text": "Le Samson tient encore au quai. Son intérieur n’est pas sûr."
    },
    {
      "chapter": 2,
      "text": "Le passage est alimenté."
    },
    {
      "chapter": 2,
      "text": "Jones reste ici, à l’abri."
    },
    {
      "chapter": 2,
      "text": "Nous descendrons équipés, pas armés comme une escouade."
    },
    {
      "chapter": 3,
      "text": "Le réservoir est plein. Évitez les longues rafales."
    },
    {
      "chapter": 3,
      "text": "Il manque une cellule compatible."
    },
    {
      "chapter": 3,
      "text": "La première travée est fermée."
    },
    {
      "chapter": 4,
      "text": "Le bruit l’éloigne de la rampe."
    },
    {
      "chapter": 4,
      "text": "La travée reste sous quarantaine."
    },
    {
      "chapter": 4,
      "text": "La commande locale répond."
    },
    {
      "chapter": 5,
      "text": "La route vers LV-178 est ouverte."
    },
    {
      "chapter": 5,
      "text": "Les balises dessinent encore une route."
    },
    {
      "chapter": 5,
      "text": "Le plan des galeries est lisible."
    },
    {
      "chapter": 6,
      "text": "La cage peut descendre."
    },
    {
      "chapter": 6,
      "text": "La remontée par cette cage est compromise."
    },
    {
      "chapter": 6,
      "text": "Les balises indiquent la galerie est."
    },
    {
      "chapter": 7,
      "text": "Le passage n’est plus sous pression."
    },
    {
      "chapter": 7,
      "text": "Des réserves. Pas assez pour rester."
    },
    {
      "chapter": 7,
      "text": "Une faille passe derrière la foreuse."
    },
    {
      "chapter": 8,
      "text": "La coque n’appartient pas à la concession."
    },
    {
      "chapter": 8,
      "text": "Il reste un passage entre les nervures."
    },
    {
      "chapter": 8,
      "text": "Ces restes ne sont pas humains."
    },
    {
      "chapter": 9,
      "text": "Le couloir se libère quelques instants."
    },
    {
      "chapter": 9,
      "text": "La suture de la coque mène vers la mine."
    },
    {
      "chapter": 9,
      "text": "Le passage est fermé. Il faut continuer."
    },
    {
      "chapter": 10,
      "text": "La remontée est possible par ce puits."
    },
    {
      "chapter": 10,
      "text": "La cellule est fixée au harnais."
    },
    {
      "chapter": 10,
      "text": "La cellule est prête pour le retour."
    },
    {
      "chapter": 11,
      "text": "La séquence d’abandon est armée."
    },
    {
      "chapter": 11,
      "text": "La concession n’est plus une route de repli."
    },
    {
      "chapter": 11,
      "text": "Le Marion dérive toujours."
    },
    {
      "chapter": 12,
      "text": "Quelque chose est resté à bord."
    },
    {
      "chapter": 12,
      "text": "Le leurre résonne dans le fret."
    },
    {
      "chapter": 12,
      "text": "La soute est perdue. La route vers l’infirmerie reste libre."
    },
    {
      "chapter": 13,
      "text": "Le matériel de soin est alimenté."
    },
    {
      "chapter": 13,
      "text": "Ripley doit rejoindre la navette."
    },
    {
      "chapter": 13,
      "text": "L’ordinateur ne doit plus commander les soins."
    },
    {
      "chapter": 14,
      "text": "La copie locale ne répond plus."
    },
    {
      "chapter": 14,
      "text": "La navette a de l’énergie."
    },
    {
      "chapter": 14,
      "text": "Le largage devra être manuel."
    },
    {
      "chapter": 15,
      "text": "La navette s’éloigne. Il faut rejoindre le Samson."
    },
    {
      "chapter": 15,
      "text": "La coque tient. La radio aussi."
    },
    {
      "chapter": 15,
      "text": "Le message part. Aucune réponse, pour l’instant."
    }
  ],
