diff --git a/scripts/alien-blackout-admission-v070.mjs b/scripts/alien-blackout-admission-v070.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/alien-blackout-admission-v070.mjs
@@ -0,0 +1,98 @@
+/** Exact Blackout source recovery and standalone delivery admission.
+ * Historical reports stay source-only; only the reviewed playable page ships.
+ */
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { lstat, readFile, mkdir, copyFile } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+
+const manifest = JSON.parse(readFileSync(new URL('./alien-blackout-files-v070.json', import.meta.url), 'utf8'));
+const sha = bytes => createHash('sha256').update(bytes).digest('hex');
+export const BLACKOUT_PUBLIC_FILES_V070 = Object.freeze(['dlc/alien-blackout/index.html']);
+export const BLACKOUT_SOURCE_TOOLS_V070 = Object.freeze([
+  'scripts/alien-blackout-admission-v070.mjs',
+  'scripts/alien-blackout-files-v070.json',
+  'scripts/verify-blackout-host-v070.mjs'
+]);
+const validPath = path => typeof path === 'string' && /^[A-Za-z0-9_./-]+$/.test(path)
+  && path.split('/').every(part => part && part !== '.' && part !== '..' && !part.startsWith('.'));
+const isRecoveredSource = path => path.startsWith('modules/alien-blackout/')
+  || path === 'archives/alien-blackout-20261125/ALIENS_TANTALUS_DLC_ALIEN_BLACKOUT_v0.7.0.zip'
+  || path === 'docs/alien-blackout/INTEGRATION_2026-11-25.md';
+
+assert.equal(manifest.schema, 1, 'Unsupported Blackout admission schema');
+assert.ok(Array.isArray(manifest.files) && manifest.files.length > 0, 'Blackout file admission is empty');
+const rows = manifest.files.map(row => {
+  assert.deepEqual(Object.keys(row).sort(), ['bytes', 'path', 'sha256']);
+  assert.ok(validPath(row.path) && (isRecoveredSource(row.path) || BLACKOUT_PUBLIC_FILES_V070.includes(row.path)),
+    'Unexpected Blackout manifest path: ' + row.path);
+  assert.ok(Number.isSafeInteger(row.bytes) && row.bytes > 0, 'Invalid Blackout file size: ' + row.path);
+  assert.match(row.sha256, /^[a-f0-9]{64}$/, 'Invalid Blackout file digest: ' + row.path);
+  return Object.freeze({ ...row });
+});
+assert.deepEqual(rows.map(row => row.path), [...new Set(rows.map(row => row.path))].sort(),
+  'Blackout admission must use unique, sorted paths');
+for (const path of BLACKOUT_PUBLIC_FILES_V070) assert.ok(rows.some(row => row.path === path), 'Missing Blackout playable admission');
+export const BLACKOUT_REPOSITORY_FILES_V070 = Object.freeze(rows);
+const sourcePaths = new Set([...rows.map(row => row.path), ...BLACKOUT_SOURCE_TOOLS_V070]);
+const publicPaths = new Set(BLACKOUT_PUBLIC_FILES_V070);
+const directoriesFor = paths => {
+  const directories = new Set();
+  for (const path of paths) {
+    const parts = path.split('/');
+    for (let count = 1; count < parts.length; count++) directories.add(parts.slice(0, count).join('/'));
+  }
+  return directories;
+};
+const sourceDirectories = directoriesFor(sourcePaths), publicDirectories = directoriesFor(publicPaths);
+const reserved = path => ['modules', 'archives', 'dlc'].some(root => path === root || path.startsWith(root + '/'))
+  || path === 'docs/alien-blackout' || path.startsWith('docs/alien-blackout/');
+
+/** null delegates unrelated paths to the existing host policy. No wildcard
+ * grants or manifest-controlled external destinations are accepted. */
+export function blackoutPathAdmissionV070(path, { directory = false, built = false } = {}) {
+  if (!validPath(path)) return reserved(String(path)) ? false : null;
+  if (BLACKOUT_SOURCE_TOOLS_V070.includes(path)) return !built && !directory;
+  if (built && (sourcePaths.has(path) || sourceDirectories.has(path)) && !publicPaths.has(path) && !publicDirectories.has(path)) {
+    return reserved(path) || path.startsWith('docs/alien-blackout') ? false : null;
+  }
+  const paths = built ? publicPaths : sourcePaths, directories = built ? publicDirectories : sourceDirectories;
+  if (directory && directories.has(path)) return true;
+  if (!directory && paths.has(path)) return true;
+  return reserved(path) ? false : null;
+}
+
+async function readVerified(root, row) {
+  const path = join(root, row.path);
+  // Reject links in every path component, including when used by the builder
+  // without the full source-tree walker.
+  let current = resolve(root);
+  assert.equal((await lstat(current)).isSymbolicLink(), false, 'Blackout root is a symbolic link');
+  for (const part of row.path.split('/')) {
+    current = join(current, part);
+    assert.equal((await lstat(current)).isSymbolicLink(), false, 'Blackout symbolic link: ' + row.path);
+  }
+  assert.equal((await lstat(path)).isFile(), true, 'Blackout entry is not a file: ' + row.path);
+  const bytes = await readFile(path);
+  assert.equal(bytes.length, row.bytes, 'Blackout size mismatch: ' + row.path);
+  assert.equal(sha(bytes), row.sha256, 'Blackout digest mismatch: ' + row.path);
+  return bytes;
+}
+
+export async function verifyBlackoutFilesV070(root, { built = false } = {}) {
+  const selected = built ? rows.filter(row => publicPaths.has(row.path)) : rows;
+  for (const row of selected) await readVerified(root, row);
+  return Object.freeze({ files: selected.length, publicFiles: publicPaths.size, nativeCampaign: false });
+}
+
+export async function copyBlackoutPublicFilesV070(root, output) {
+  assert.notEqual(resolve(root), resolve(output), 'Blackout build output must differ from source');
+  for (const row of rows.filter(row => publicPaths.has(row.path))) {
+    await readVerified(root, row);
+    const target = join(output, row.path);
+    await mkdir(dirname(target), { recursive: true });
+    await copyFile(join(root, row.path), target);
+  }
+  return verifyBlackoutFilesV070(output, { built: true });
+}
