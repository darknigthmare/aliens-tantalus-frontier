+(() => {
+  'use strict';
+
+  // The repository serves this one entry point. A downloaded portable file,
+  // module preview or unrelated origin path must not gain a broken return link.
+  const current = new URL(window.location.href);
+  if (!['https:', 'http:'].includes(current.protocol)
+      || current.pathname !== '/dlc/alien-blackout/index.html') return;
+  const destination = new URL('../../index.html', current);
+  if (destination.origin !== current.origin) return;
+
+  const app = window.app;
+  if (!app?.engine || typeof app.save !== 'function') return;
+  const panels = [...document.querySelectorAll('[data-tantalus-return-panel]')];
+  const buttons = [...document.querySelectorAll('[data-tantalus-return]')];
+  const titleExport = document.getElementById('tantalus-export-title');
+  const exportButton = document.getElementById('export');
+  const statuses = [
+    document.getElementById('tantalus-return-title-status'),
+    document.getElementById('tantalus-return-system-status'),
+  ].filter(Boolean);
+  let returning = false;
+
+  function notify(text) {
+    statuses.forEach(status => { status.textContent = text; });
+  }
+
+  function returnToTantalus() {
+    if (returning) return;
+    const engine = app.engine;
+    engine.paused = true;
+    // Reuse the native v7 save contract. Never rewrite a slot in inspection,
+    // migrate a schema here, or touch the host campaign's storage.
+    if (engine.status !== 'menu' && !app.inspection) {
+      let saved = false;
+      try { saved = app.save(true) === true; } catch { /* Remain in Blackout. */ }
+      if (!saved) {
+        notify('Retour suspendu : la sauvegarde locale est indisponible. Exportez votre sauvegarde JSON avant de quitter.');
+        if (titleExport) titleExport.hidden = false;
+        const inTitle = document.getElementById('title-dialog')?.open;
+        (inTitle ? titleExport : exportButton)?.focus();
+        return;
+      }
+    }
+    returning = true;
+    buttons.forEach(button => { button.disabled = true; });
+    try {
+      window.location.assign(destination.href);
+    } catch {
+      returning = false;
+      buttons.forEach(button => { button.disabled = false; });
+      notify('Le navigateur a bloqué le retour. Vous pouvez réessayer.');
+    }
+  }
+
+  panels.forEach(panel => { panel.hidden = false; });
+  buttons.forEach(button => button.addEventListener('click', returnToTantalus));
+  titleExport?.addEventListener('click', () => exportButton?.click());
+})();
